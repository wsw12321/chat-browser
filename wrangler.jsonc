{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-browser",
  "account_id": "b68ecca47666ea7dddc54d78451c5acd",
  "main": "apps/edge/src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chat.water555.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_ORIGIN": "https://chat.water555.com",
    "GATEWAY_ORIGIN": "https://codex.water555.com",
    "POLICY_VERSION": "file-policy-v1",
    "APP_CONTRACT_VERSION": "1",
    "MODEL_CAPABILITIES": "[{\"id\":\"gpt-5.5\",\"images\":true},{\"id\":\"gpt-5.6\",\"images\":true},{\"id\":\"gpt-6\",\"images\":true}]",
    "FEATURE_PDF": "false",
    "FEATURE_DOCX": "false",
    "FEATURE_IMAGES": "true",
  },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
}
