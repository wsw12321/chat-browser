{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-browser",
  "main": "apps/edge/src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_ORIGIN": "https://chat.example.com",
    "GATEWAY_ORIGIN": "https://gateway.example.com",
    "POLICY_VERSION": "file-policy-v1",
    "APP_CONTRACT_VERSION": "1",
    "MODEL_CAPABILITIES": "[]",
    "FEATURE_PDF": "false",
    "FEATURE_DOCX": "false",
    "FEATURE_IMAGES": "false",
  },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
}
